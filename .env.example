# ---------------------------------------------------------------------------
# Order Management Platform — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env is excluded from Git. NEVER commit real secrets, keys, or credentials.
# Every service validates its required variables at startup and fails fast
# with a clear message if one is missing.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# --- Datastores ------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/order_management_platform
REDIS_URL=redis://localhost:6379

# --- Authentication --------------------------------------------------------
# Generate a strong random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Service ports ---------------------------------------------------------
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
PAYMENT_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

# --- Internal service URLs (used by the gateway and inter-service calls) ---
AUTH_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002
ORDER_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# --- API security ----------------------------------------------------------
# Comma-separated allowlist of browser origins. No wildcards.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Sensitive routes (login, register) use a tighter limit
AUTH_RATE_LIMIT_MAX=10

# --- Caching ---------------------------------------------------------------
CACHE_TTL_SECONDS=300
CATEGORY_CACHE_TTL_SECONDS=3600

# --- Background jobs -------------------------------------------------------
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_DELAY_MS=1000
# How many jobs the notification worker processes in parallel
QUEUE_CONCURRENCY=5

# --- Payment gateway (Razorpay — TEST MODE ONLY) ---------------------------
# From the Razorpay dashboard in test mode. Key ID is safe to expose to the
# browser; the secret and webhook secret are server-side only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_signing_secret

# --- Push notifications (Web Push / VAPID) ---------------------------------
# Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# --- Seed data (local development only) ------------------------------------
# Used by `npm run seed` to create the test accounts documented in the README.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_local_password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=replace_with_local_password

# --- Frontend (Vite) -------------------------------------------------------
# VITE_ variables are embedded in the client bundle and are PUBLIC.
# Never put a secret behind a VITE_ prefix.
VITE_API_BASE_URL=http://localhost:4000
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
VITE_VAPID_PUBLIC_KEY=replace_with_vapid_public_key
